{
  "ai": {
    "provider": "anthropic",
    "api_key_env": "ANTHROPIC_API_KEY",
    "openai_api_key_env": "OPENAI_API_KEY",
    "gemini_api_key_env": "GEMINI_API_KEY",
    "spark_api_key_env": "SPARK_API_KEY",
    "base_url": "http://127.0.0.1:8000/v1",
    "openai_base_url": "https://api.openai.com/v1",
    "spark_health_url": "http://127.0.0.1:8080/health",
    "enable_thinking": false,
    "sentiment_model": "claude-haiku-4-5-20251001",
    "extract_model": "claude-sonnet-5",
    "max_tokens": 1024,
    "extract_max_tokens": 4096,
    "request_timeout_sec": 30,
    "extract_timeout_sec": 120
  },
  "dedup_policy": "skip",
  "sentiment_grade": {
    "strong_threshold": 0.75
  },
  "cleaning": {
    "min_review_length": 5,
    "trim_whitespace": true
  },
  "pagination": {
    "default_page_size": 10
  },
  "visualization": {
    "output_dir": "output",
    "dpi": 130,
    "font_candidates": [
      "/usr/share/fonts/truetype/nanum/NanumGothic.ttf",
      "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc",
      "Malgun Gothic",
      "AppleGothic",
      "NanumGothic",
      "Noto Sans CJK KR"
    ]
  },
  "alert": {
    "recent_days": 7,
    "negative_ratio_threshold": 0.4,
    "relative_increase_threshold": 1.3
  },
  "storage": {
    "db_path": "data/reviews.db"
  },
  "logging": {
    "log_dir": "logs",
    "level": "INFO"
  }
}
